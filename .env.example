APP_ENV=development
# SQLite is the zero-dependency default; docker-compose overrides with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./shoescout.db
# Optional infrastructure (adapters activate when set)
REDIS_URL=
ELASTICSEARCH_URL=
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# Server-side provider key fallbacks. Keys saved in Admin -> Settings override these and are encrypted at rest.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Required in production; a local dev key is auto-generated otherwise.
CREDENTIALS_ENCRYPTION_KEY_B64=
# Signs the admin session cookie. Required in production.
ADMIN_AUTH_SECRET=
ADMIN_USERNAME=admin
# Production: Argon2id hash from `python -m scripts.hash_password <password>`
ADMIN_PASSWORD_HASH=
# Local development only (hashed at startup, never ship a default):
ADMIN_PASSWORD=

DEFAULT_LLM_MODEL=gpt-4.1-mini
DEFAULT_VISION_MODEL=gpt-4.1-mini
DEFAULT_STT_MODEL=scribe_v2_realtime
DEFAULT_TTS_MODEL=eleven_flash_v2_5
DEFAULT_ELEVENLABS_VOICE_ID=
DEFAULT_CURRENCY=GBP
MOCK_MODE=true
SEED_ON_STARTUP=true
